{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Home Office Tracker",
  "version": "0.1.0",
  "identifier": "com.losicek.homeofficetracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Home Office Tracker",
        "width": 980,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Losenicky Design",
    "copyright": "© 2026 Losenicky Design · MIT License",
    "category": "Productivity",
    "shortDescription": "Working time tracker for home office",
    "longDescription": "Track working time, breaks and time per application while working from home. Automatic break after inactivity, daily/weekly/monthly reports, Excel and CSV export. Data stays on your computer.",
    "homepage": "https://www.losenicky.design"
  }
}
